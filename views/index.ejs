<%- include('partials/header') %>

<section class="hero">
  <h1>Thoughts, worth publishing.</h1>
  <p>A tiny blog for tiny (and not-so-tiny) ideas. No sign-up, no database, just posts.</p>
</section>

<section class="filter-bar" aria-label="Filter posts by category">
  <a href="/" class="chip <%= activeCategory === 'All' ? 'chip-active' : '' %>">All</a>
  <% categories.forEach(cat => { %>
    <a href="/?category=<%= encodeURIComponent(cat) %>" class="chip <%= activeCategory === cat ? 'chip-active' : '' %>"><%= cat %></a>
  <% }) %>
</section>

<section class="post-list">
  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <p>No posts <% if (activeCategory !== 'All') { %>in "<%= activeCategory %>" <% } %>yet.</p>
      <a href="/posts/new" class="btn btn-primary">Write the first one</a>
    </div>
  <% } else { %>
    <% posts.forEach(post => { %>
      <article class="post-card">
        <div class="post-card-top">
          <span class="badge badge-<%= post.category.toLowerCase() %>"><%= post.category %></span>
          <time datetime="<%= post.createdAt.toISOString() %>">
            <%= post.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
            &middot;
            <%= post.createdAt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
          </time>
        </div>

        <h2 class="post-title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
        <p class="post-author">by <strong><%= post.author %></strong></p>
        <p class="post-excerpt">
          <%= post.content.length > 180 ? post.content.slice(0, 180).trim() + '…' : post.content %>
        </p>

        <div class="post-card-actions">
          <a href="/posts/<%= post.id %>" class="btn btn-ghost btn-sm">Read more</a>
          <a href="/posts/<%= post.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
          <form action="/posts/<%= post.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this post? This cannot be undone.');">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  <% } %>
</section>

<%- include('partials/footer') %>
